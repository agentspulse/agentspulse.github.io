{% assign latest_fallback = site.tutorials | sort: 'date' | reverse %}
{% assign ordered = "" | split: "" %}
{% assign seen_slugs = "" | split: "" %}
{% assign popular_pinned_slug = "self-evolving-agents-review-en" %}
{% assign popular_pinned_post = site.tutorials | where: "slug", popular_pinned_slug | first %}
{% if popular_pinned_post %}{% assign ordered = ordered | push: popular_pinned_post %}{% assign seen_slugs = seen_slugs | push: popular_pinned_slug %}{% endif %}
{% for popular_slug in site.data.popular.ordered_slugs %}
{% assign popular_post = site.tutorials | where: "slug", popular_slug | first %}
{% if popular_post %}{% unless seen_slugs contains popular_slug %}{% assign ordered = ordered | push: popular_post %}{% assign seen_slugs = seen_slugs | push: popular_slug %}{% endunless %}{% endif %}
{% endfor %}
{% for post in latest_fallback %}{% unless seen_slugs contains post.slug %}{% assign ordered = ordered | push: post %}{% endunless %}{% endfor %}
{% assign all_tags = "" | split: "" %}
{% for post in ordered %}{% for tag in post.tags %}{% assign all_tags = all_tags | push: tag %}{% endfor %}{% endfor %}
{% assign all_tags = all_tags | uniq | sort %}

<header class="sky-header">
<div class="sky-header-row">
<div class="sky-header-copy">
<h1>{{ include.title }}</h1>
<p class="sky-sub">{{ include.subtitle }}</p>
</div>
<div class="sky-view-toggle" role="group" aria-label="Toggle post view">
<button type="button" class="sky-view-btn sky-view-active" data-view="grid" aria-label="Grid view"><i class="ti ti-layout-grid"></i></button>
<button type="button" class="sky-view-btn" data-view="list" aria-label="List view"><i class="ti ti-list"></i></button>
</div>
</div>
<p class="sky-count" data-total="{{ ordered | size }}">{{ ordered | size }} agent research {% if ordered.size == 1 %}digest{% else %}digests{% endif %}.</p>
</header>

{% assign fp = site.featured_post %}
{% if fp.enabled %}
{% assign fp_doc = site.tutorials | where: "url", fp.url | first %}
{% assign fp_title = fp.title | default: fp_doc.title %}
{% assign fp_desc = fp.description | default: fp_doc.description %}
{% assign fp_collage = site.data.collages[fp_doc.slug] %}
{% assign fp_image = fp.image | default: fp_collage.featured | default: fp_doc.thumbnail %}
{% assign fp_read = fp_doc.content | number_of_words | divided_by: 180 | plus: 1 %}
<a class="sky-featured" href="{{ fp.url | relative_url }}" aria-label="{{ fp_title | strip_html }}">
<span class="sky-featured-body">
<span class="sky-featured-eyebrow">{{ fp.eyebrow | default: "Featured" }}{% if fp_doc %}<span class="sky-featured-dot"></span>{{ fp_doc.paper_count }} papers<span class="sky-featured-dot"></span>{{ fp_read }} min read{% endif %}</span>
<strong class="sky-featured-title">{{ fp_title }}</strong>
<span class="sky-featured-desc">{{ fp_desc | strip_html }}</span>
<span class="sky-featured-cta"><span>{{ fp.cta | default: "Read more" }}</span><span class="sky-featured-arrow"><i class="ti ti-arrow-right" aria-hidden="true"></i></span></span>
</span>
{% if fp_image %}<span class="sky-featured-figures">
<img src="{{ fp_image | relative_url }}" alt="Figures from {{ fp_title | strip_html }}" width="1040" height="780" loading="lazy" decoding="async">
</span>{% endif %}
</a>
{% endif %}

<div class="sky-search">
<span class="sky-search-icon"><i class="ti ti-search"></i></span>
<input type="text" class="sky-search-input" placeholder="Search agent research..." aria-label="Search agent research" autocomplete="off">
<button type="button" class="sky-search-clear" aria-label="Clear search" hidden><i class="ti ti-x"></i></button>
</div>

<div class="sky-chips">
{% for tag in all_tags %}<button type="button" class="sky-chip" data-tag="{{ tag | downcase }}">{{ tag }}</button>{% endfor %}
</div>

<div class="sky-results-toolbar">
<div class="sky-sort-toggle" role="group" aria-label="Sort research articles">
<span class="sky-sort-label">Sort by</span>
<button type="button" class="sky-sort-btn sky-sort-active" data-sort="popular" aria-pressed="true"><i class="ti ti-flame" aria-hidden="true"></i>Popular</button>
<button type="button" class="sky-sort-btn" data-sort="latest" aria-pressed="false"><i class="ti ti-clock" aria-hidden="true"></i>Latest</button>
</div>
</div>

<p class="sky-empty" hidden>No agent research matches your search.</p>

<div class="sky-posts" data-view="grid">

<div class="sky-grid">
{% for post in ordered %}
{% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
{% assign pop_entry = site.data.popular.pages[post.slug] %}
{% assign pop_views = pop_entry.views | default: 0 %}
{% assign git_entry = site.data.git_order.pages[post.slug] %}
{% assign git_committed_at = git_entry.committed_at | default: 0 %}
{% assign popular_pinned = 0 %}{% if post.slug == popular_pinned_slug %}{% assign popular_pinned = 1 %}{% endif %}
{% assign thumb = site.data.collages[post.slug].card | default: post.thumbnail | default: "/images/359239/figure-1.jpg" %}
{% capture tagstr %}{% for tag in post.tags %}{{ tag | downcase }} {% endfor %}{% endcapture %}
<a class="sky-card" href="{{ post.url | relative_url }}" data-popular="{{ pop_views }}" data-popular-pinned="{{ popular_pinned }}" data-latest="{{ git_committed_at }}" data-title="{{ post.title | downcase | escape }}" data-tags="{{ tagstr | strip }}" data-search="{{ post.title | append: ' ' | append: post.description | append: ' ' | append: tagstr | strip_html | downcase | escape }}">
<div class="sky-card-thumb"><img src="{{ thumb | relative_url }}" alt="Figures from {{ post.title }}" loading="lazy" width="900" height="563"></div>
<div class="sky-card-body">
<div class="sky-card-tags">{% for tag in post.tags limit: 2 %}<span data-tag="{{ tag | downcase }}">{{ tag }}</span>{% endfor %}</div>
<h3>{{ post.title }}</h3>
<p>{{ post.description | strip_html | truncate: 130 }}</p>
<div class="sky-card-meta"><span>{{ read_time }} min read{% if pop_views > 0 %}<span class="sky-meta-dot"></span>{{ pop_views }} views{% endif %}</span><span class="sky-arrow"><i class="ti ti-arrow-right"></i></span></div>
</div>
</a>
{% endfor %}
</div>

<div class="sky-list">
{% for post in ordered %}
{% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
{% assign pop_entry = site.data.popular.pages[post.slug] %}
{% assign pop_views = pop_entry.views | default: 0 %}
{% assign git_entry = site.data.git_order.pages[post.slug] %}
{% assign git_committed_at = git_entry.committed_at | default: 0 %}
{% assign popular_pinned = 0 %}{% if post.slug == popular_pinned_slug %}{% assign popular_pinned = 1 %}{% endif %}
{% assign thumb = site.data.collages[post.slug].card | default: post.thumbnail | default: "/images/359239/figure-1.jpg" %}
{% capture tagstr %}{% for tag in post.tags %}{{ tag | downcase }} {% endfor %}{% endcapture %}
<a class="sky-row" href="{{ post.url | relative_url }}" data-popular="{{ pop_views }}" data-popular-pinned="{{ popular_pinned }}" data-latest="{{ git_committed_at }}" data-title="{{ post.title | downcase | escape }}" data-tags="{{ tagstr | strip }}" data-search="{{ post.title | append: ' ' | append: post.description | append: ' ' | append: tagstr | strip_html | downcase | escape }}">
<div class="sky-row-thumb"><img src="{{ thumb | relative_url }}" alt="Figures from {{ post.title }}" loading="lazy" width="900" height="563"></div>
<div class="sky-row-body">
<h3>{{ post.title }}</h3>
<p>{{ post.description | strip_html | truncate: 160 }}</p>
<div class="sky-row-meta"><span class="sky-row-tags">{% for tag in post.tags limit: 2 %}<span data-tag="{{ tag | downcase }}">{{ tag }}</span>{% endfor %}</span><span class="sky-row-dot"></span><span>{{ read_time }} min read{% if pop_views > 0 %}<span class="sky-meta-dot"></span>{{ pop_views }} views{% endif %}</span></div>
</div>
</a>
{% endfor %}
</div>

</div>
