{% assign adsense_client = site.adsense.client | default: '' | strip %}
{% if jekyll.environment == 'production' and site.adsense.enabled and adsense_client != '' %}
  <script
    async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ adsense_client | escape }}"
    crossorigin="anonymous"
  ></script>
{% endif %}
