<!doctype html>
<html lang="{{ page.lang | default: site.lang }}">
  <head>
    {% include head.liquid %}
  </head>
  <body class="design-replica-body">
    <div class="design-replica-shell replica-sky">
<a class="sky-skip-link" href="#main-content">Skip to content</a>
{% include sky-nav.liquid active='paper' %}
{% assign topic_posts = '' | split: '' %}
{% for post in site.tutorials %}
  {% if post.tags contains page.topic_tag %}
    {% assign topic_posts = topic_posts | push: post %}
  {% endif %}
{% endfor %}
{% assign topic_posts = topic_posts | sort: 'date' | reverse %}
{% assign topic_updated = page.last_modified_at | default: page.date %}
<main class="sky-main sky-topic-main" id="main-content">
<nav class="sky-breadcrumb" aria-label="Breadcrumb">
<a href="{{ '/' | relative_url }}">Papers</a><i class="ti ti-chevron-right" aria-hidden="true"></i>
{% if page.parent_topic_url %}<a href="{{ page.parent_topic_url | relative_url }}">{{ page.parent_topic_title }}</a><i class="ti ti-chevron-right" aria-hidden="true"></i>{% endif %}
<span aria-current="page">{{ page.topic_name }}</span>
</nav>

<header class="sky-topic-hero">
<h1>{{ page.display_title | default: page.title }}</h1>
<p class="sky-topic-lede">{{ page.lede | default: page.description }}</p>
<p class="sky-topic-meta">
<span>{{ topic_posts | size }} {% if topic_posts.size == 1 %}article{% else %}articles{% endif %}</span>
{% if topic_updated %}<span>Updated <time datetime="{{ topic_updated | date: '%Y-%m-%d' }}">{{ topic_updated | date: '%b %-d, %Y' }}</time></span>{% endif %}
{% if page.repo_url %}<a href="{{ page.repo_url }}" rel="noopener"><i class="ti ti-brand-github" aria-hidden="true"></i>{{ page.repo_label | default: "GitHub" }}</a>{% endif %}
</p>
{% if page.facts %}
<dl class="sky-topic-facts">
{% for fact in page.facts %}<div><dt>{{ fact.label }}</dt><dd>{% if fact.url %}<a href="{{ fact.url | relative_url }}">{{ fact.value }}</a>{% else %}{{ fact.value }}{% endif %}</dd></div>{% endfor %}
</dl>
{% endif %}
</header>

{% if page.article_groups %}
{% for group in page.article_groups %}
{% assign group_posts = '' | split: '' %}
{% assign group_tags = group.tags | default: group.tag %}{% for post in topic_posts %}{% assign hit = false %}{% for gt in group_tags %}{% if post.tags contains gt %}{% assign hit = true %}{% endif %}{% endfor %}{% if hit %}{% assign group_posts = group_posts | push: post %}{% endif %}{% endfor %}
{% if group_posts.size > 0 %}
<section class="sky-topic-articles" id="{{ group.id }}" aria-labelledby="{{ group.id }}-title">
<h2 id="{{ group.id }}-title">{{ group.title }} <span>{{ group_posts | size }}</span></h2>
<div class="sky-grid">
{% for post in group_posts %}{% include sky-topic-card.liquid post=post %}{% endfor %}
</div>
</section>
{% endif %}
{% endfor %}
{% else %}
<section class="sky-topic-articles" aria-labelledby="topic-articles-title">
<h2 id="topic-articles-title">{{ page.articles_title | default: "Articles" }} <span>{{ topic_posts | size }}</span></h2>
<div class="sky-grid">
{% for post in topic_posts %}{% include sky-topic-card.liquid post=post %}{% endfor %}
</div>
</section>
{% endif %}

<div class="sky-topic-content">
{{ content }}

{% if page.timeline %}
<h2 id="updates">{{ page.timeline_title | default: "Updates" }}</h2>
<ul class="sky-topic-log">
{% for item in page.timeline %}
<li><time datetime="{{ item.date }}">{{ item.date | date: '%b %-d, %Y' }}</time><span>{% if item.url %}<a href="{{ item.url | relative_url }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}{% if item.body %} — {{ item.body }}{% endif %}</span></li>
{% endfor %}
</ul>
{% endif %}

{% if page.sources %}
<h2 id="sources">{{ page.sources_title | default: "Sources" }}</h2>
<ul class="sky-topic-log">
{% for source in page.sources %}<li><a href="{{ source.url }}" rel="noopener">{{ source.name }}</a>{% if source.description %} — {{ source.description }}{% endif %}</li>{% endfor %}
</ul>
{% endif %}
</div>
</main>
{% include sky-footer.liquid %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": {{ page.url | absolute_url | append: '#collection' | jsonify }},
      "name": {{ page.title | jsonify }},
      "description": {{ page.description | jsonify }},
      "url": {{ page.url | absolute_url | jsonify }},
      "inLanguage": {{ page.lang | default: site.lang | jsonify }},{% if topic_updated %}
      "dateModified": {{ topic_updated | date_to_xmlschema | jsonify }},{% endif %}{% if page.og_image %}
      "primaryImageOfPage": {"@type": "ImageObject", "url": {{ page.og_image | absolute_url | jsonify }}},{% endif %}
      "about": {
        "@type": {{ page.about_type | default: "Thing" | jsonify }},
        "name": {{ page.topic_name | jsonify }}{% if page.about_url %},
        "url": {{ page.about_url | jsonify }}{% endif %}{% if page.repo_url and page.about_type == "SoftwareSourceCode" %},
        "codeRepository": {{ page.repo_url | jsonify }}{% endif %}{% if page.about_license %},
        "license": {{ page.about_license | jsonify }}{% endif %}
      },
      "isPartOf": {"@type": "WebSite", "name": {{ site.title | jsonify }}, "url": {{ site.url | append: '/' | jsonify }}},
      "breadcrumb": {"@id": {{ page.url | absolute_url | append: '#breadcrumb' | jsonify }}},
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ topic_posts | size }},
        "itemListElement": [{% for post in topic_posts %}
          {"@type": "ListItem", "position": {{ forloop.index }}, "url": {{ post.url | absolute_url | jsonify }}, "name": {{ post.title | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": {{ page.url | absolute_url | append: '#breadcrumb' | jsonify }},
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Papers", "item": {{ site.url | append: '/' | jsonify }}},{% if page.parent_topic_url %}
        {"@type": "ListItem", "position": 2, "name": {{ page.parent_topic_title | jsonify }}, "item": {{ page.parent_topic_url | absolute_url | jsonify }}},
        {"@type": "ListItem", "position": 3, "name": {{ page.topic_name | jsonify }}, "item": {{ page.url | absolute_url | jsonify }}}{% else %}
        {"@type": "ListItem", "position": 2, "name": {{ page.topic_name | jsonify }}, "item": {{ page.url | absolute_url | jsonify }}}{% endif %}
      ]
    }
  ]
}
</script>
    </div>
  </body>
</html>
